# ==============================================================================
# Exam Hall Seating Allocator - Frontend Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env or .env.local for local customization:
#   cp .env.example .env.local
#
# Note: Vite only exposes environment variables prefixed with VITE_ to client code.
# Never place database credentials, JWT secrets, or private keys in frontend env files!

# Local Development (Spring Boot backend running locally on port 8083):
VITE_API_BASE_URL=http://localhost:8083

# Production Deployment (Set as Environment Variable in Vercel Project Settings):
# VITE_API_BASE_URL=https://exam-seating-backend.onrender.com
